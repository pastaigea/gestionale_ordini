# In locale l'app parte in modalita demo se i valori Supabase non sono presenti.
# La modalita demo usa esclusivamente dati fittizi salvati nel browser.
VITE_APP_MODE=demo
VITE_BASE_PATH=/

# Modalita reale (queste due chiavi sono identificatori pubblici protetti da RLS,
# non segreti amministrativi). Non inserire mai SUPABASE_SERVICE_ROLE_KEY qui.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
