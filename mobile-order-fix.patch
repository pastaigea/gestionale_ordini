--- a/src/styles.css
+++ b/src/styles.css
@@ -599,3 +599,103 @@
 @media (prefers-reduced-motion: reduce) {
   *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
 }
+
+/* Mobile ordering experience */
+.mobile-order-bar { display: none; }
+
+@media (max-width: 700px) {
+  html { scroll-padding-bottom: 110px; }
+  .main-content { padding-bottom: 118px; }
+
+  .billing-summary { gap: 0; overflow: hidden; }
+  .billing-summary > div { padding: 14px; }
+  .billing-summary > div + div { border-top: 1px solid var(--line); }
+
+  .order-form { gap: 14px; }
+  .order-form__main { gap: 14px; }
+  .order-form__section { padding: 15px; }
+  .section-heading { margin-bottom: 15px; }
+  .section-heading h2 { font-size: 18px; }
+  .section-heading p { font-size: 12.5px; line-height: 1.45; }
+
+  .catalog-toolbar { position: sticky; top: 62px; z-index: 15; margin: -3px -3px 14px; padding: 8px 3px 10px; background: rgba(255, 255, 255, .96); backdrop-filter: blur(9px); }
+  .catalog-toolbar .search-input input { min-height: 48px; font-size: 16px; }
+  .category-tabs { padding-bottom: 2px; scrollbar-width: thin; }
+  .category-tabs button { min-height: 40px; padding: 9px 14px; font-size: 12px; }
+
+  .product-grid { gap: 9px; }
+  .product-card { padding: 14px; border-radius: 13px; }
+  .product-card__visual { display: none; }
+  .product-card__category { font-size: 10px; }
+  .product-card h3 { margin: 3px 0 4px; font-size: 16px; line-height: 1.25; }
+  .product-card p { font-size: 11.5px; line-height: 1.35; }
+  .product-card__promo { margin-top: 3px; font-size: 9px; }
+  .product-card__bottom { align-items: center; margin-top: 12px; }
+  .product-card__bottom > strong { font-size: 13px; }
+  .product-card__price > span { font-size: 14px; }
+  .product-card__bottom > strong small { font-size: 10px; }
+  .quantity-control { flex: 0 0 auto; grid-template-columns: 44px 48px 44px; border-radius: 11px; }
+  .quantity-control button { width: 44px; height: 44px; }
+  .quantity-control input { width: 48px; min-height: 44px; height: 44px; font-size: 16px; }
+
+  .field__label { font-size: 14px; }
+  .field__hint, .field__error { font-size: 12px; }
+  input, select, textarea { min-height: 48px; font-size: 16px; }
+  textarea { min-height: 96px; }
+  .payment-choice__option { min-height: 72px; padding: 14px; }
+  .payment-choice__option strong { font-size: 14px; }
+  .payment-choice__option small { font-size: 11px; }
+
+  .order-summary { scroll-margin-top: 76px; }
+  .order-summary > .card { padding: 16px; }
+  .order-summary__title h2 { font-size: 17px; }
+  .order-summary__title p { font-size: 11px; }
+  .order-summary__line { font-size: 12px; }
+  .order-summary__line small { font-size: 10px; }
+  .order-summary__line b { font-size: 12px; }
+  .order-summary__totals > div { font-size: 12px; }
+  .order-summary__grand strong { font-size: 20px; }
+  .order-summary .button { width: 100%; min-height: 50px; }
+
+  .mobile-order-bar {
+    position: fixed;
+    left: 0;
+    right: 0;
+    bottom: 0;
+    z-index: 54;
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 12px;
+    min-height: 76px;
+    padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
+    border-top: 1px solid #d6e1ed;
+    background: rgba(255, 255, 255, .97);
+    box-shadow: 0 -10px 30px rgba(9, 45, 82, .14);
+    backdrop-filter: blur(12px);
+  }
+  .mobile-order-bar > div { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
+  .mobile-order-bar strong { color: var(--blue-900); font-size: 18px; }
+  .mobile-order-bar span { overflow: hidden; color: var(--muted); font-size: 11px; text-overflow: ellipsis; white-space: nowrap; }
+  .mobile-order-bar button {
+    min-height: 48px;
+    flex: 0 0 auto;
+    padding: 10px 15px;
+    border: 0;
+    border-radius: 11px;
+    background: var(--blue-700);
+    color: #fff;
+    font-size: 13px;
+    font-weight: 800;
+    box-shadow: 0 5px 14px rgba(32, 97, 183, .22);
+  }
+}
+
+@media (max-width: 430px) {
+  .product-card__bottom { align-items: center; flex-direction: row; }
+  .quantity-control { align-self: auto; grid-template-columns: 42px 46px 42px; }
+  .quantity-control button { width: 42px; height: 44px; }
+  .quantity-control input { width: 46px; }
+  .mobile-order-bar { padding-left: 11px; padding-right: 11px; }
+  .mobile-order-bar button { padding-inline: 12px; }
+}
